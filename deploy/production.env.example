# Содержимое GitHub secret PRODUCTION_ENV. Случайные пароли: openssl rand -hex 32.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
S3_ACCESS_KEY=fsp-server
S3_SECRET_KEY=REPLACE_WITH_RANDOM_HEX
S3_BUCKET=fsp-private
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Необязательный отдельный пароль интерфейса тестовой почты, формат user:password.
# Без этого значения письма доступны всем, кто открывает порт 8025.
MAILPIT_UI_AUTH=team:REPLACE_WITH_RANDOM_HEX
WEB_PUBLIC_URL=http://89.104.69.242:3000
# Только для текущего HTTP-окружения. При переходе на HTTPS установить true.
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=*
PUBLIC_HOST=89.104.69.242

# Начальная настройка суперадмина командой migrate up. После активации значения можно удалить.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
