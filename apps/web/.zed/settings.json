{
  "languages": {
    "JavaScript": {
      "language_servers": ["eslint", "..."],
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TypeScript": {
      "language_servers": ["eslint", "..."],
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "TSX": {
      "language_servers": ["eslint", "..."],
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    }
  },
  "lsp": {
    "eslint": {
      "settings": {
        "workingDirectory": {
          "mode": "auto"
        }
      }
    }
  },
  "prettier": {
    "allowed": true
  }
}
