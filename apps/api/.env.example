# Запуск из apps/api: set -a; source .env; set +a; go run ./cmd/api
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://fsp:local-postgres-change-me@localhost:5432/fsp?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=local-redis-change-me
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=local-fsp
S3_SECRET_KEY=local-s3-change-me
S3_BUCKET=fsp-private
# Go на хосте обращается к Keycloak через опубликованный порт.
OIDC_ISSUER=http://localhost:8180/realms/fsp
OIDC_CLIENT_ID=fsp-api
OIDC_INTERNAL_URL=
# Любой фронтенд может обращаться с Bearer-токеном, cookies не используются.
CORS_ALLOWED_ORIGINS=*

# Начальная настройка суперадмина командой migrate up. После активации значения можно удалить.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
