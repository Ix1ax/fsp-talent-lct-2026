{
  "realm": "fsp",
  "displayName": "FSP Talent",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "sslRequired": "none",
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@fsp.local",
    "fromDisplayName": "FSP Talent",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "candidate"
      },
      {
        "name": "employer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "fsp-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "fsp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fsp-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "${WEB_PUBLIC_URL}/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "${WEB_PUBLIC_URL}"
      ]
    },
    {
      "clientId": "fsp-swagger",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "fsp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fsp-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:8080/docs/oauth2-redirect.html",
        "http://localhost:3000/docs/oauth2-redirect.html",
        "${API_PUBLIC_URL}/docs/oauth2-redirect.html"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:3000",
        "${API_PUBLIC_URL}"
      ]
    },
    {
      "clientId": "fsp-api",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "fsp-local-test",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "fsp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fsp-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev@example.test",
      "email": "dev@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Local",
      "lastName": "Developer",
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ]
    }
  ],
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru"
  ],
  "defaultLocale": "ru"
}
